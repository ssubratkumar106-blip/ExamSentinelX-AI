# ── Application Secrets ────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit the .env file to git

SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=another-secret-key-for-jwt-tokens

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///database/examsentinelx.db

# ── Application ────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=True
HOST=0.0.0.0
PORT=5000

# ── Mail / OTP Configuration ──────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ── OAuth Configuration (Google) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret


# ── AI Configuration ──────────────────────────────────────────────────────────
YOLO_MODEL_PATH=ai/models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
FACE_ABSENCE_THRESHOLD_SEC=3
HEAD_POSE_YAW_LIMIT=30
HEAD_POSE_PITCH_LIMIT=20

# ── Admin Account (seed data) ─────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@examsentinelx.ai
ADMIN_PASSWORD=Admin@123456
