# ════════════════════════════════════════════════════════════════════════════════
# ExamSentinelX AI — Environment Configuration (EXAMPLE)
# ════════════════════════════════════════════════════════════════════════════════
# RULES:
#   - NO spaces around = sign: KEY=value  ✅   KEY= value  ❌
#   - NEVER commit your actual .env file to GitHub
#   - Restart the server after changing anything here
# ════════════════════════════════════════════════════════════════════════════════

# ── Flask Security Keys ──────────────────────────────────────────────────────────
# Random strings used to sign cookies. Keep secret!
SECRET_KEY=<YOUR_SECRET_KEY>
JWT_SECRET_KEY=<YOUR_JWT_SECRET_KEY>
# SECURITY WARNING: DO NOT EXPOSE THESE OAuth SECRETS IN PUBLIC
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>


# ── Database ─────────────────────────────────────────────────────────────────────
# Replace with your PostgreSQL/Supabase URL or leave blank for local SQLite
DATABASE_URL=<YOUR_DATABASE_URL>

# ── Application Settings ─────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=True
HOST=0.0.0.0
PORT=5000

# ── AI Detection Sensitivity ─────────────────────────────────────────────────────
YOLO_MODEL_PATH=ai/models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
FACE_ABSENCE_THRESHOLD_SEC=3
HEAD_POSE_YAW_LIMIT=30
HEAD_POSE_PITCH_LIMIT=20

# ── Admin Account ─────────────────────────────────────────────────────────────────
# ADMIN_PASSWORD rules:
#   ✅ Min 8 characters
#   ✅ At least 1 uppercase letter (A-Z)
#   ✅ At least 1 number (0-9)
#   ✅ At least 1 special character (@, #, !, $, etc.)
#   Example strong password: ExamAdmin@2024
ADMIN_USERNAME=<ADMIN_USERNAME_HERE>
ADMIN_EMAIL=<ADMIN_EMAIL_HERE>
ADMIN_PASSWORD=<ADMIN_PASSWORD_HERE>

# ════════════════════════════════════════════════════════════════════════════════
# OPTIONAL APIs — Only activate if you need those features
# ════════════════════════════════════════════════════════════════════════════════

# ── Email Alerts & OTP Verification ─────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=<YOUR_GMAIL_ADDRESS>
MAIL_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>
MAIL_DEFAULT_SENDER=<YOUR_GMAIL_ADDRESS>

# ── Kaggle Dataset Download (optional) ───────────────────────────────────────────
# ⚠️  KAGGLE_USERNAME must be your Kaggle profile username (not your full name!)
KAGGLE_USERNAME=<YOUR_KAGGLE_USERNAME>
KAGGLE_KEY=<YOUR_KAGGLE_API_KEY>

# ── Roboflow (optional) ───────────────────────────────────────────────────────────
ROBOFLOW_API_KEY=<YOUR_ROBOFLOW_API_KEY>

# ── HuggingFace (optional) ────────────────────────────────────────────────────────
HUGGINGFACE_TOKEN=<YOUR_HUGGINGFACE_TOKEN>
